        <mxCell id="1" parent="0"/>
        <mxCell id="n1" value="Ciclo de vida do cadastro de uma ONG" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#030f18;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="900" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="Coluna usuarios.status. Cada decis&#xE3;o da equipe grava um log (logs_admin), o checklist (verificacoes) e um aviso no sino da ONG (notificacoes). O servidor confere o status atual antes de cada transi&#xE7;&#xE3;o." style="text;html=1;fontSize=13;fontColor=#1d4052;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="30" y="58" width="1300" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="" style="ellipse;html=1;fillColor=#030f18;strokeColor=#030f18;" vertex="1" parent="1">
          <mxGeometry x="40" y="215" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;pages/cadastro.php&lt;/b&gt;&lt;br&gt;dados da ONG, respons&#xE1;vel legal,&lt;br&gt;canal p&#xFA;blico, PIX = CNPJ, senha forte" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#72a3bf;fontColor=#030f18;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="110" y="175" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="pendente&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;fora do site; o login avisa que est&#xE1; em an&#xE1;lise&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#fff3d6;strokeColor=#a66a00;strokeWidth=2;fontColor=#030f18;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="185" width="240" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="aprovada&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;perfil p&#xFA;blico + selo &amp;quot;Verificada&amp;quot;&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d6f5eb;strokeColor=#007a55;strokeWidth=2;fontColor=#030f18;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="185" width="280" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="recusada&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;o login pede para falar com a equipe&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#fde8e8;strokeColor=#c0392b;strokeWidth=2;fontColor=#030f18;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="470" width="240" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="suspensa&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;sai do ar na hora e a sess&#xE3;o perde o acesso&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#fff3d6;strokeColor=#a66a00;strokeWidth=2;fontColor=#030f18;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1020" y="470" width="280" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="" style="ellipse;html=1;shape=doubleEllipse;fillColor=#030f18;strokeColor=#030f18;" vertex="1" parent="1">
          <mxGeometry x="1470" y="213" width="34" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="&lt;b&gt;conta exclu&#xED;da&lt;/b&gt;&lt;br&gt;CASCADE + arquivos do disco" style="text;html=1;fontSize=13;fontColor=#1d4052;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1420" y="255" width="200" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#446e87;fontSize=11;fontColor=#1d4052;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n3" target="n4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e12" value="INSERT&lt;br&gt;status = pendente" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#446e87;fontSize=11;fontColor=#1d4052;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n4" target="n5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e13" value="aprovar&lt;br&gt;(11 itens obrigat&#xF3;rios,&lt;br&gt;conferidos de novo no servidor)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#007a55;fontSize=11;fontColor=#00563c;labelBackgroundColor=#ffffff;strokeWidth=2;" edge="1" parent="1" source="n5" target="n6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e14" value="recusar&lt;br&gt;(motivo obrigat&#xF3;rio)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#c0392b;fontSize=11;fontColor=#8e2a20;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n5" target="n7">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e15" value="aprovar ap&#xF3;s corre&#xE7;&#xE3;o&lt;br&gt;(checklist completo)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#007a55;fontSize=11;fontColor=#00563c;labelBackgroundColor=#ffffff;strokeWidth=2;exitX=1;exitY=0.25;entryX=0;entryY=0.85;" edge="1" parent="1" source="n7" target="n6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e16" value="suspender&lt;br&gt;(motivo)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#c0392b;fontSize=11;fontColor=#8e2a20;labelBackgroundColor=#ffffff;exitX=0.4;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="n6" target="n8">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e17" value="reativar&lt;br&gt;(nova verifica&#xE7;&#xE3;o)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#007a55;fontSize=11;fontColor=#00563c;labelBackgroundColor=#ffffff;strokeWidth=2;exitX=0.8;exitY=0;entryX=0.95;entryY=1;" edge="1" parent="1" source="n8" target="n6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e18" value="aprovar de novo = reverifica&#xE7;&#xE3;o" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#007a55;fontSize=11;fontColor=#00563c;labelBackgroundColor=#ffffff;strokeWidth=2;exitX=0.3;exitY=0;entryX=0.7;entryY=0;" edge="1" parent="1" source="n6" target="n6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e19" value="a ONG exclui a conta" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#446e87;fontSize=11;fontColor=#1d4052;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n6" target="n9">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;b&gt;O que cada estado permite&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;pendente&lt;/b&gt;: n&#xE3;o entra na &#xE1;rea da ONG e n&#xE3;o aparece em nenhuma lista nem busca.&lt;br&gt;&lt;b&gt;aprovada&lt;/b&gt;: entra, lan&#xE7;a contas, publica not&#xED;cias, recebe avisos; aparece no site com a data da &#xFA;ltima verifica&#xE7;&#xE3;o.&lt;br&gt;&lt;b&gt;recusada&lt;/b&gt;: n&#xE3;o entra; o login pede para falar com a equipe, e o motivo fica no hist&#xF3;rico da an&#xE1;lise.&lt;br&gt;&lt;b&gt;suspensa&lt;/b&gt;: perde o acesso na pr&#xF3;xima p&#xE1;gina (o status &#xE9; revalidado a cada requisi&#xE7;&#xE3;o) e some do site; os dados ficam guardados." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#c9b458;fontColor=#3a3a3a;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="30" y="640" width="640" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;b&gt;Transi&#xE7;&#xF5;es aceitas pelo servidor (admin/acao.php)&lt;/b&gt;&lt;br&gt;&#x2022; suspender: s&#xF3; de &lt;i&gt;aprovada&lt;/i&gt;&lt;br&gt;&#x2022; reativar: s&#xF3; de &lt;i&gt;suspensa&lt;/i&gt;&lt;br&gt;&#x2022; recusar: de &lt;i&gt;pendente&lt;/i&gt;, &lt;i&gt;recusada&lt;/i&gt; ou &lt;i&gt;suspensa&lt;/i&gt; (aprovada se suspende)&lt;br&gt;&#x2022; aprovar: de qualquer estado, sempre com o checklist completo&lt;br&gt;&lt;br&gt;&lt;b&gt;Corre&#xE7;&#xF5;es sem mudar o status&lt;/b&gt;: chave PIX (sempre o CNPJ), respons&#xE1;vel legal, e-mail de aprova&#xE7;&#xE3;o enviado." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#c9b458;fontColor=#3a3a3a;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="720" y="640" width="620" height="170" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
